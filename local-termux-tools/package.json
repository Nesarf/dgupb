{
  "name": "local-termux-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "Termux 小工具",
      "en": "Termux Tools"
    },
    "icon": "terminal",
    "wants": [
      "clipboard",
      "draft"
    ],
    "contributes": {
      "composer.tools": [
        {
          "id": "termux-panel",
          "label": {
            "zh": "手机",
            "en": "Phone"
          },
          "icon": "terminal",
          "panel": "phone"
        }
      ],
      "panels": [
        {
          "id": "phone",
          "title": {
            "zh": "Termux 小工具",
            "en": "Termux Tools"
          },
          "icon": "terminal",
          "placement": [
            "features",
            "session.tab",
            "chat.panel"
          ]
        }
      ]
    }
  }
}