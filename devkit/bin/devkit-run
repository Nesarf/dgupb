#!/usr/bin/env bash
# devkit-run — start/stop/status for the localhost bridge.
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
PIDF="$DIR/bridge.pid"
LOG="$DIR/bridge.log"
PORT="${DEVKIT_PORT:-8737}"

is_up() {
  [ -f "$PIDF" ] && kill -0 "$(cat "$PIDF")" 2>/dev/null
}

case "${1:-status}" in
  start)
    if is_up; then echo "already running (pid $(cat "$PIDF")) on :$PORT"; exit 0; fi
    nohup "$DIR/bin/devkit-bridge" "$PORT" >>"$LOG" 2>&1 &
    echo $! >"$PIDF"
    sleep 0.4
    if is_up; then echo "started pid $(cat "$PIDF") on http://127.0.0.1:$PORT"; else echo "failed, see $LOG" >&2; exit 1; fi
    ;;
  stop)
    if is_up; then kill "$(cat "$PIDF")" 2>/dev/null && echo "stopped"; else echo "not running"; fi
    rm -f "$PIDF"
    ;;
  restart)
    "$0" stop; sleep 0.3; "$0" start
    ;;
  status)
    if is_up; then
      echo "running pid $(cat "$PIDF") on :$PORT"
      curl -s --max-time 3 "http://127.0.0.1:$PORT/status" || true
      echo
    else
      echo "not running"
    fi
    ;;
  log) tail -n "${2:-30}" "$LOG" 2>/dev/null || echo "no log" ;;
  *) echo "usage: devkit-run {start|stop|restart|status|log}" >&2; exit 2 ;;
esac
